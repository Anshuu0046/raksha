# ─────────────────────────────────────────────────────────────────────────────
# Raksha environment. Copy to .env.local for development.
# Never commit real values. Only NEXT_PUBLIC_* values are exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of this deployment (used in alert links, OAuth redirects, CSRF origin checks).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo mode: no real SMS/email/push, emergency numbers are never dialled, simulated location,
# in-memory database allowed. Shows a "DEMO MODE" banner everywhere. NEVER enable for a pilot.
NEXT_PUBLIC_DEMO_MODE=false

# 32+ random characters. Used for OTP hashing and IP pseudonymisation.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Comma-separated emails promoted to admin on sign-in.
ADMIN_EMAILS=

# Time zone used in alert messages.
APP_TIMEZONE=Asia/Kolkata

# ── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# Required in production unless demo mode is on. Leave empty in development to use the in-memory store.
DATABASE_URL=
DATABASE_POOL_MAX=5

# ── Scheduler ────────────────────────────────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/process every minute.
CRON_SECRET=

# ── SMS (choose one) ─────────────────────────────────────────────────────────
# SMS_PROVIDER=twilio | msg91 | console   (console = log only, for staging)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# TextBee: free SMS through your own Android phone's SIM, no DLT (SMS_PROVIDER=textbee). See docs/NOTIFICATIONS.md
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# MSG91 (India, DLT-registered templates required; see docs/NOTIFICATIONS.md)
MSG91_AUTH_KEY=
MSG91_SOS_TEMPLATE_ID=
MSG91_OTP_TEMPLATE_ID=
MSG91_GENERIC_TEMPLATE_ID=

# ── Email (choose one: Gmail SMTP or Resend) ─────────────────────────────────
# Option A: Gmail SMTP (free, no domain required! Uses a Google App Password)
SMTP_USER=
SMTP_PASS=
# Option B: Resend (requires custom domain)
RESEND_API_KEY=
EMAIL_FROM="Raksha Alerts <alerts@your-domain.in>"

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@your-domain.in

# ── Google sign-in (optional) ────────────────────────────────────────────────
# Authorised redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Maps & places ────────────────────────────────────────────────────────────
# Tiles: OpenStreetMap by default. For a pilot use a commercial tile provider (e.g. MapTiler)
# and add its host to img-src (next.config.ts derives it from this URL automatically).
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=
# Nearby places: Google Places (New) if set, otherwise OpenStreetMap Overpass.
GOOGLE_PLACES_API_KEY=
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# Geocoding (Nominatim). Public instance allows ~1 req/s; use your own or a provider for a pilot.
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_CONTACT_EMAIL=

# ── Recording storage (Supabase Storage, private bucket) ─────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RECORDINGS_BUCKET=recordings

# Development only: enable the service worker under `next dev`.
NEXT_PUBLIC_ENABLE_SW=false
